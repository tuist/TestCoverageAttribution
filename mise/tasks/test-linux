#!/bin/bash
#MISE description="Build the package and run Fixtures/Example's tests on Linux, where the package records nothing"
set -euo pipefail

CONTAINER_RUNTIME=$(command -v podman || command -v docker || true)
if [ -z "$CONTAINER_RUNTIME" ]; then
    echo "Neither podman nor docker is available. Please install one to proceed."
    exit 1
fi

# Mounted under its own name: the fixture depends on the package by path, and SwiftPM names a
# path dependency after its directory.
"$CONTAINER_RUNTIME" run --rm \
    --volume "$MISE_PROJECT_ROOT:/TestCoverageAttribution" \
    --workdir /TestCoverageAttribution \
    swift:6.1.0 \
    /bin/bash -c "swift build --configuration release --scratch-path .build/linux \
        && swift test --package-path Fixtures/Example --scratch-path .build/linux-fixture"
